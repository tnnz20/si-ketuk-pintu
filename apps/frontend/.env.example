# ==============================================================================
# Si Ketuk Pintu - Frontend Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#      cp apps/frontend/.env.example apps/frontend/.env
# 2. Adjust settings to match your environment.
# 3. In Vite, only variables prefixed with 'VITE_' are exposed to client bundle.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend API Base URL
# ------------------------------------------------------------------------------
# Root URL of the Si Ketuk Pintu Go REST API backend.
# - Local development: http://localhost:8080
# - Production: https://api.yourdomain.go.id
# Note: Do NOT include a trailing slash!
VITE_API_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# Cloudflare Turnstile Bot Protection (Public Site Key)
# ------------------------------------------------------------------------------
# Public site key used to render the Turnstile challenge widget on public forms (SubmissionForm.tsx).
# - Development: Leave empty to bypass captcha in development mode, or use Cloudflare's
#   always-pass test key: '1x00000000000000000000AA'
# - Production: Must match the TURNSTILE_SITE_KEY configured on the backend.
# Get your keys at: https://dash.cloudflare.com/?to=/:account/turnstile
VITE_TURNSTILE_SITE_KEY=

# ------------------------------------------------------------------------------
# Application Environment Mode
# ------------------------------------------------------------------------------
# Sets the runtime mode ('development', 'staging', or 'production').
# In 'development', automatic mock fallback tokens are generated if Turnstile site key is empty.
VITE_APP_ENV=development
