# ==============================================================================
# Si Ketuk Pintu - Backend Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#      cp apps/backend/.env.example apps/backend/.env
# 2. Update the credentials and settings according to your environment.
# 3. NEVER commit the actual '.env' file or production secrets to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Server Settings
# ------------------------------------------------------------------------------
# APP_ENV: Runtime environment mode ('development', 'staging', or 'production').
# In 'production', security enforcements (like Cloudflare Turnstile) are strictly required.
APP_ENV=development

# APP_HOST: Network interface/IP address the HTTP server binds to.
# Use '0.0.0.0' to accept requests from all network interfaces (Docker/container friendly),
# or '127.0.0.1' for local loopback only.
APP_HOST=0.0.0.0

# APP_PORT: Port number on which the HTTP server listens (default: 8080).
APP_PORT=8080

# LOG_LEVEL: Logging verbosity level ('debug', 'info', 'warn', 'error').
# Recommended: 'debug' for local development, 'info' or 'warn' for production.
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# Primary PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# Connection settings for the runtime application database.
# In local development with Make/Docker/Podman ('make compose-up'), these match compose.yaml.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=si_ketuk_pintu
POSTGRES_USER=skp
POSTGRES_PASSWORD=change-me-before-use
# POSTGRES_SSLMODE: 'disable' for local dev, 'require' or 'verify-full' for production.
POSTGRES_SSLMODE=disable

# ------------------------------------------------------------------------------
# Test PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# Dedicated, isolated database used ONLY when executing integration and migration tests
# (e.g. 'make be-test', 'make be-test-migrations').
# IMPORTANT: Test suites will wipe and recreate tables here; never point to a production DB!
TEST_POSTGRES_HOST=localhost
TEST_POSTGRES_PORT=5432
TEST_POSTGRES_DB=si_ketuk_pintu_test
TEST_POSTGRES_USER=skp
TEST_POSTGRES_PASSWORD=change-me-before-use
TEST_POSTGRES_SSLMODE=disable

# ------------------------------------------------------------------------------
# SSH Tunnel Configuration (Optional)
# ------------------------------------------------------------------------------
# Used when running migrations or database seed tools against a remote server behind an SSH bastion.
# Activated by passing the '--ssh' flag to CLI tools or using Make SSH targets:
# e.g., 'make migrate-up-ssh', 'make seed-admin-ssh'.
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_PASSWORD=
SSH_KNOWN_HOSTS_FILE=

# Remote PostgreSQL parameters accessed via the SSH tunnel:
SSH_POSTGRES_HOST=127.0.0.1
SSH_POSTGRES_PORT=5432
SSH_POSTGRES_DATABASE=
SSH_POSTGRES_USER=
SSH_POSTGRES_PASSWORD=
SSH_POSTGRES_SSLMODE=disable

# ------------------------------------------------------------------------------
# File Uploads Storage
# ------------------------------------------------------------------------------
# Filesystem directory where visitor request attachments and attendance docs are stored.
# Path can be relative to apps/backend or absolute. Directory will be created automatically.
UPLOAD_DIR=./var/uploads

# ------------------------------------------------------------------------------
# Authentication & JWT Settings
# ------------------------------------------------------------------------------
# JWT_SECRET: Cryptographic secret key used to sign and verify admin JSON Web Tokens.
# CAUTION: In production, generate a strong, random 256-bit+ string (e.g. `openssl rand -hex 32`).
JWT_SECRET=change-me-to-a-random-secret

# JWT_EXPIRY_HOURS: Lifetime duration of admin authentication tokens in hours (default: 24).
JWT_EXPIRY_HOURS=24

# ------------------------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing) & Rate Limiting
# ------------------------------------------------------------------------------
# CORS_ORIGINS: Comma-separated list of allowed web origins permitted to make API requests.
# Add your production frontend domain here when deploying (e.g. https://siketukpintu.domain.go.id).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# RATE_LIMIT_RPS: Maximum requests per second allowed per client IP address.
# Protects public endpoints from flooding and abuse.
RATE_LIMIT_RPS=10

# ------------------------------------------------------------------------------
# Cloudflare Turnstile Bot Protection
# ------------------------------------------------------------------------------
# CAPTCHA verification for public visitor request submissions.
# - In 'development': Leave empty to run in bypass/test mode.
# - In 'production': BOTH keys are MANDATORY; the backend will fail to start if empty.
# Get your keys at: https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ------------------------------------------------------------------------------
# Initial Administrator Seeding Credentials
# ------------------------------------------------------------------------------
# Used by 'make seed-admin' ('go run ./cmd/seed admin') to bootstrap the initial superadmin.
# Once seeded into the database, these variables are no longer needed at runtime.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
